# Restart Metro after changes (`npx expo start -c` if needed).
EXPO_PUBLIC_API_URL=http://localhost:4000
# Physical phone on the same Wi-Fi: run `./scripts/print-lan-api-url.sh` from the repo root.
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_SYNC_ENABLED=true
